<Window x:Class="ChartDepth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ChartDepth.Models"
        xmlns:viewModels="clr-namespace:ChartDepth.ViewModels"
        xmlns:views="clr-namespace:ChartDepth.Views"
        xmlns:local="clr-namespace:ChartDepth"
        mc:Ignorable="d"
        Title="Chart Depth - Order Book" 
        Height="600" 
        Width="1200"
        MinHeight="500"
        MinWidth="900"
        Background="#0A0E1A">

    <Window.DataContext>
        <viewModels:ChartViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- ===== MATCHING COLOR PALETTE ===== -->
        <Color x:Key="BgDark">#0A0E1A</Color>
        <Color x:Key="BgPanel">#111827</Color>
        <Color x:Key="BgPanelLight">#1A202E</Color>
        <Color x:Key="BgHover">#1E293B</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentBlueLight">#60A5FA</Color>
        <Color x:Key="AccentBlueDark">#2563EB</Color>
        <Color x:Key="AccentCyan">#06B6D4</Color>
        <Color x:Key="TextPrimary">#F1F5F9</Color>
        <Color x:Key="TextSecondary">#CBD5E1</Color>
        <Color x:Key="TextDim">#64748B</Color>
        <Color x:Key="BorderSubtle">#334155</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
        <SolidColorBrush x:Key="BgPanelLightBrush" Color="{StaticResource BgPanelLight}" />
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
        <SolidColorBrush x:Key="AccentBlueLightBrush" Color="{StaticResource AccentBlueLight}" />
        <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="{StaticResource AccentBlueDark}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />

        <!-- ===== NAVIGATION BUTTON STYLE ===== -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="8,4">
                            <Grid>
                                <!-- Active indicator bar -->
                                <Border x:Name="activeBar"
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        CornerRadius="0,2,2,0"
                                        Background="{StaticResource AccentBlueBrush}"
                                        Opacity="0"/>

                                <ContentPresenter x:Name="contentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>

                            <!-- Pressed/Active State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueLightBrush}"/>
                                <Setter TargetName="activeBar" Property="Opacity" Value="1"/>
                            </Trigger>

                            <!-- Active State (use Tag="Active" on button) -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueLightBrush}"/>
                                <Setter TargetName="activeBar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== SETTINGS BUTTON STYLE ===== -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Settings Icon -->
                                <TextBlock Text="⚙" 
                                          FontSize="16" 
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgPanelLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Border Grid.Row="0" 
                Grid.Column="0" 
                Grid.ColumnSpan="2" 
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Orientation="Horizontal" 
                           VerticalAlignment="Center" 
                           Margin="20,0,0,0">
                    <TextBlock Text="Chart Depth" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentBlueBrush}"
                           CornerRadius="4"
                           Padding="6,2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center">
   
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Grid.Column="0" 
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="NAVIGATION" 
                          Foreground="{StaticResource TextDimBrush}"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Margin="20,20,20,10"/>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="Order Book" 
                           Style="{StaticResource NavButtonStyle}"
                           Tag="Active"/>
                    <Button Content="My Orders" 
                           Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Trades" 
                           Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Analytics" 
                           Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Alerts" 
                           Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    <Border Background="{StaticResource BgPanelLightBrush}"
                           BorderBrush="{StaticResource BorderSubtleBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="12">
                        <StackPanel>
                            <TextBlock Text="Market Status" 
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextDimBrush}"
                                      Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" 
                                        Fill="#10B981" 
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Connected" 
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Action Bar -->
                <Border Background="{StaticResource BgPanelBrush}"
                       BorderBrush="{StaticResource BorderSubtleBrush}"
                       BorderThickness="0,0,0,1"
                       Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

           
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            
                        </StackPanel>

                        <!-- Settings Button -->
                        <Button Content="Settings" 
                               Grid.Column="1"
                               Style="{StaticResource SettingsButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <views:ChartView Grid.Row="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>