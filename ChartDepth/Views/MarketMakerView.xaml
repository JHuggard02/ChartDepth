<UserControl x:Class="ChartDepth.Views.MarketMakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChartDepth.Views"
             xmlns:converter="clr-namespace:ChartDepth.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>

        <converter:PercentageConverter x:Key="PercentageConverter" />

        <!-- ===== MODERN COLOR PALETTE ===== -->
        <Color x:Key="BgDark">#0A0E1A</Color>
        <!-- Deep navy background -->
        <Color x:Key="BgPanel">#111827</Color>
        <!-- Card background -->
        <Color x:Key="BgPanelLight">#1A202E</Color>
        <!-- Lighter panel -->
        <Color x:Key="BgHover">#1E293B</Color>
        <!-- Hover state -->
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <!-- Primary accent -->
        <Color x:Key="AccentCyan">#06B6D4</Color>
        <!-- Secondary accent -->
        <Color x:Key="TextPrimary">#F1F5F9</Color>
        <!-- Bright text -->
        <Color x:Key="TextSecondary">#CBD5E1</Color>
        <!-- Secondary text -->
        <Color x:Key="TextDim">#64748B</Color>
        <!-- Dim text -->
        <Color x:Key="GridLines">#1E293B</Color>
        <!-- Subtle grid lines -->
        <Color x:Key="BorderSubtle">#334155</Color>
        <!-- Subtle borders -->

        <!-- Ask/Bid colors with better contrast -->
        <Color x:Key="AskRed">#EF4444</Color>
        <Color x:Key="AskRedDim">#DC2626</Color>
        <Color x:Key="BidGreen">#10B981</Color>
        <Color x:Key="BidGreenDim">#059669</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
        <SolidColorBrush x:Key="BgPanelLightBrush" Color="{StaticResource BgPanelLight}" />
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
        <SolidColorBrush x:Key="GridLinesBrush" Color="{StaticResource GridLines}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />

        <!-- ===== USERCONTROL BACKGROUND ===== -->
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- ===== DATAGRID ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#00000000"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Column Headers -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgPanelLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- Rows with enhanced hover and selection -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#1E40AF" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#1E40AF" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cells with better spacing -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== CANVAS BACKGROUND ===== -->
        <Style TargetType="Canvas">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
        </Style>

        <!-- ===== PRICE TEXT ON CANVAS ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
        </Style>

        <!-- ===== ASK RECTANGLES ===== -->
        <Style x:Key="AskRectangleStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource AskRedDim}" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource AskRed}" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== BID RECTANGLES ===== -->
        <Style x:Key="BidRectangleStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource BidGreenDim}" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource BidGreen}" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== GRID CONTAINER STYLE ===== -->
        <Style x:Key="PanelContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource PanelContainerStyle}">
            <Canvas x:Name="canvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Candles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding ActualWidth, ElementName=canvas}" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Style="{StaticResource AskRectangleStyle}">
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="CandleBodyHeight" />
                                    </MultiBinding>
                                </Rectangle.Height>
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth"/>
                                        <Binding Path="CandleWidth" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="BodyTopOffset" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth"/>
                                        <Binding Path="LeftHorizontalOffset"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>


                <ItemsControl ItemsSource="{Binding Candles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line Stroke="{StaticResource BgPanelLightBrush}" StrokeThickness="3" SnapsToDevicePixels="True">
                                <Line.X1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="LeftHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X1>
                                <Line.Y1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="HighHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y1>
                                <Line.X2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="RightHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X2>
                                <Line.Y2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="HighHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y2>
                            </Line>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Candles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line Stroke="{StaticResource BgPanelLightBrush}" StrokeThickness="3" SnapsToDevicePixels="True">
                                <Line.X1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="MiddleHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X1>
                                <Line.Y1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="HighHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y1>
                                <Line.X2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="MiddleHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X2>
                                <Line.Y2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="BodyTopOffset" />
                                    </MultiBinding>
                                </Line.Y2>
                            </Line>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <ItemsControl ItemsSource="{Binding Candles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line Stroke="{StaticResource BgPanelLightBrush}" StrokeThickness="3" SnapsToDevicePixels="True">
                                <Line.X1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="MiddleHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X1>
                                <Line.Y1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="BodyBottomOffset" />
                                    </MultiBinding>
                                </Line.Y1>
                                <Line.X2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="MiddleHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X2>
                                <Line.Y2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="LowHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y2>
                            </Line>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Candles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line Stroke="{StaticResource BgPanelLightBrush}" StrokeThickness="3" SnapsToDevicePixels="True">
                                <Line.X1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="LeftHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X1>
                                <Line.Y1>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="LowHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y1>
                                <Line.X2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth" />
                                        <Binding Path="RightHorizontalOffset" />
                                    </MultiBinding>
                                </Line.X2>
                                <Line.Y2>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="LowHorizontalLineOffset" />
                                    </MultiBinding>
                                </Line.Y2>
                            </Line>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
