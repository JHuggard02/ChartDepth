<UserControl x:Class="ChartDepth.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:ChartDepth.Converters"
             xmlns:local="clr-namespace:ChartDepth.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:PercentageConverter x:Key="PercentageConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <TextBox Text="{Binding RectWidth}" />
        <!--<Canvas Background="Gray" Grid.Column="1" x:Name="canvas">
            <Rectangle Height="10" Canvas.Top="0" Canvas.Right="0" Fill="Red" >
                <Rectangle.Width>
                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                        <Binding ElementName="canvas" Path="ActualWidth"/>
                        <Binding Path="RectWidth" PresentationTraceSources.TraceLevel="High"/>
                    </MultiBinding>
                </Rectangle.Width>
            </Rectangle>
        </Canvas>-->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Canvas x:Name="priceCanvas" Background="Gray" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding ChartPrices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding ActualWidth, ElementName=canvas}"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Yellow"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Price}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="priceCanvas" Path="ActualHeight" />
                                        <Binding Path="Offset" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Left" Value="10"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>

            <Canvas x:Name="canvas" Background="Gray" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding AskRectangles}" >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding ActualWidth, ElementName=canvas}"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Yellow"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Fill="Red" Stroke="Black" StrokeThickness="0.5">
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="Height" />
                                    </MultiBinding>
                                </Rectangle.Height>
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth"/>
                                        <Binding Path="Quantity" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="Offset" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Right" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding BidRectangles}" >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding ActualWidth, ElementName=canvas}"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Yellow"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Fill="Green" Stroke="Black" StrokeThickness="0.5">
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="Height" />
                                    </MultiBinding>
                                </Rectangle.Height>
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualWidth"/>
                                        <Binding Path="Quantity" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PercentageConverter}">
                                        <Binding ElementName="canvas" Path="ActualHeight" />
                                        <Binding Path="Offset" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Left" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

               
            </Canvas>
        </Grid>
        
        
        

    </Grid>
</UserControl>
