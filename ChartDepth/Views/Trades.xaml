<UserControl x:Class="ChartDepth.Views.Trades"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChartDepth.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- ===== MATCHING COLOR PALETTE ===== -->
        <Color x:Key="BgDark">#0A0E1A</Color>
        <Color x:Key="BgPanel">#111827</Color>
        <Color x:Key="BgPanelLight">#1A202E</Color>
        <Color x:Key="BgHover">#1E293B</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="AccentCyan">#06B6D4</Color>
        <Color x:Key="TextPrimary">#F1F5F9</Color>
        <Color x:Key="TextSecondary">#CBD5E1</Color>
        <Color x:Key="TextDim">#64748B</Color>
        <Color x:Key="BorderSubtle">#334155</Color>
        <Color x:Key="SuccessGreen">#10B981</Color>
        <Color x:Key="ErrorRed">#EF4444</Color>
        <Color x:Key="WarningYellow">#F59E0B</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
        <SolidColorBrush x:Key="BgPanelLightBrush" Color="{StaticResource BgPanelLight}" />
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
        <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}" />

        <!-- ===== USERCONTROL BACKGROUND ===== -->
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
        </Style>

        <!-- ===== DATAGRID STYLE ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#00000000"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- ===== COLUMN HEADERS ===== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgPanelLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- ===== ROWS ===== -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#1E40AF" Opacity="0.2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== CELLS ===== -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== PNL TEXT STYLE ===== -->
        <Style x:Key="PnlTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ===== PANEL CONTAINER STYLE ===== -->
        <Style x:Key="PanelContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- ===== SECTION HEADER STYLE ===== -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12" Background="{StaticResource BgDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== PAST TRADES PANEL ===== -->
        <Border Grid.Column="0" Style="{StaticResource PanelContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="{StaticResource BgPanelLightBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,12"
                        CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" 
                                  FontSize="18" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Past Trades" 
                                  Style="{StaticResource SectionHeaderStyle}"
                                  Margin="0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding PastTrades}" BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Date Column -->
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="Auto" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ticker Column -->
                        <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Price Column -->
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="Auto" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Volume Column -->
                        <DataGridTextColumn Header="VOLUME" Binding="{Binding Volume}" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Side Column with Pill -->
                        <DataGridTemplateColumn Header="SIDE" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" MinWidth="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Side}" Value="BUY">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{StaticResource SuccessGreen}" Opacity="0.15"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessGreenBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Side}" Value="SELL">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{StaticResource ErrorRed}" Opacity="0.15"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorRedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Side}" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="11"
                                                  HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Side}" Value="BUY">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Side}" Value="SELL">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Error Column with Pill -->
                        <DataGridTemplateColumn Header="ERROR" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" MaxWidth="200"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{StaticResource ErrorRed}" Opacity="0.15"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorRedBrush}"/>
                                                <Setter Property="Visibility">
                                                    <Setter.Value>
                                                        <Binding Path="Error">
                                                            <Binding.Converter>
                                                                <local:NullToVisibilityConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Error}" 
                                                  Foreground="{StaticResource ErrorRedBrush}"
                                                  FontSize="11"
                                                  FontWeight="Medium"
                                                  TextTrimming="CharacterEllipsis"
                                                  ToolTip="{Binding Error}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== OPEN POSITIONS PANEL ===== -->
        <Border Grid.Column="1" Style="{StaticResource PanelContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="{StaticResource BgPanelLightBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,12"
                        CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" 
                                  FontSize="18" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Open Positions" 
                                  Style="{StaticResource SectionHeaderStyle}"
                                  Margin="0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding OpenPositions}" BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Ticker Column -->
                        <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="Auto" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Direction Column with Pill -->
                        <DataGridTemplateColumn Header="DIRECTION" Width="Auto" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" MinWidth="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="LONG">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{StaticResource SuccessGreen}" Opacity="0.15"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessGreenBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="SHORT">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{StaticResource ErrorRed}" Opacity="0.15"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorRedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Direction}" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="11"
                                                  HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="LONG">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="SHORT">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Side Column -->
                        <DataGridTextColumn Header="SIDE" Binding="{Binding Side}" Width="Auto" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Volume Column -->
                        <DataGridTextColumn Header="VOLUME" Binding="{Binding Volume}" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- PNL Column with Color Coding -->
                        <DataGridTemplateColumn Header="PNL" Width="*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PNL, StringFormat={}{0:N2}}" 
                                              Style="{StaticResource PnlTextStyle}">
                                        <TextBlock.Foreground>
                                            <Binding Path="PNL">
                                                <Binding.Converter>
                                                    <local:PnlColorConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>